# Copy to .env and fill in.

# Host interface and port the API is published on.
# Keep 127.0.0.1 unless a proxy on another machine needs to reach it.
BIND_ADDR=127.0.0.1
HOST_PORT=8000

# Container user, so files in ./data are owned by you (run `id -u` / `id -g`).
UID=1000
GID=1000

# Log level: debug | info | warn | error (logs are JSON)
LOG_LEVEL=info

# Base URL clients reach the server at. Used in OAuth metadata and redirects.
# Set it to your public HTTPS URL (e.g. a Cloudflare Tunnel) to use ChatGPT, Claude or Gemini.
PUBLIC_URL=http://localhost:8000

# Anyone who can reach the server can create an account while this is true.
# Set it to false once your accounts exist.
SIGNUP_ENABLED=true

# Only for upgrading a database from before accounts existed: on startup,
# expenses without an owner go to this account, created with AUTH_PASSWORD
# as its password (or found by email). Leave empty on a fresh install.
OWNER_EMAIL=
AUTH_PASSWORD=
