# Copy to .env and fill in.

# Host interface and port the API is published on.
# Keep 127.0.0.1 unless a proxy on another machine needs to reach it.
BIND_ADDR=127.0.0.1
HOST_PORT=8000

# Container user, so files in ./data are owned by you (run `id -u` / `id -g`).
UID=1000
GID=1000

# debug | info | warn | error
LOG_LEVEL=info

# API tokens: API_TOKEN_<NAME>=<scopes>:<secret>
# Scopes: read, write, delete (comma-separated). Secret: at least 32 chars.
# Generate a secret with: openssl rand -hex 32
API_TOKEN_ME=read,write,delete:change-me
